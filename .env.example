# Google Gemini API key used ONLY by the server (server/index.js).
# Get one from Google AI Studio: https://aistudio.google.com/apikey
# Never expose this in client-side code.
GEMINI_API_KEY=

# Firebase service account key (Firestore access). Paste the ENTIRE
# contents of the JSON file downloaded from:
# Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key. As one single-line value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Secret used to sign login session tokens (JWT). Any long random
# string — e.g. `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=

# Secret used only to let Firestore enforce "username + PIN combo must
# be unique" without storing PINs in a reversible form. Any long random
# string, different from JWT_SECRET — e.g. `openssl rand -hex 32`.
PIN_LOOKUP_SECRET=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
PORT=5174
