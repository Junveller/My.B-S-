# Google Gemini API key used ONLY by the server (server/index.js).
# Get one from Google AI Studio: https://aistudio.google.com/apikey
# Never expose this in client-side code.
GEMINI_API_KEY=

# Postgres connection string. For local dev, point this at a local
# Postgres (e.g. postgres://user:pass@localhost:5432/mybiseo). On
# Render, use the database's connection string (render.yaml wires this
# up automatically if you deploy the Blueprint).
DATABASE_URL=

# Secret used to sign login session tokens (JWT). Any long random
# string — e.g. `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=

# Secret used only to let the database enforce "username + PIN combo
# must be unique" without storing PINs in a reversible form. Any long
# random string, different from JWT_SECRET — e.g. `openssl rand -hex 32`.
PIN_LOOKUP_SECRET=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
PORT=5174
